# Cross-compile LLVM tools that run on 64-bit Windows from Linux.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
# The environment also reaches CMake's nested try_compile projects.
set(sdk "$ENV{NBCPP_LLVM_MINGW}")
set(triple x86_64-w64-mingw32)
foreach(lang IN ITEMS C CXX ASM)
  set(CMAKE_${lang}_COMPILER_TARGET "${triple}")
endforeach()
set(CMAKE_C_COMPILER   "${sdk}/bin/${triple}-clang")
set(CMAKE_CXX_COMPILER "${sdk}/bin/${triple}-clang++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_RC_COMPILER  "${sdk}/bin/${triple}-windres")
set(CMAKE_AR           "${sdk}/bin/llvm-ar")
set(CMAKE_RANLIB       "${sdk}/bin/llvm-ranlib")
set(CMAKE_FIND_ROOT_PATH "${sdk}/${triple}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

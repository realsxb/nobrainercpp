{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build C",
            "command": "C:\\Old NBCpp\\lldbv1.0\\bin\\clang.exe",
            "args": [
                "-target",
                "x86_64-w64-mingw32",
                "--sysroot",
                "C:/Old NBCpp/lldbv1.0/x86_64-w64-mingw32",
                "-Wno-unused-command-line-argument",
                "-stdlib=libc++",
                "-lunwind",
                "--rtlib=compiler-rt",
                "-fuse-ld=lld",
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "使用内置 Micro-Clang 编译"
        },
        {
            "type": "shell",
            "label": "Build C++",

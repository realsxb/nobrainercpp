{
  "name": "nobrainercpp",
  "displayName": "NBCpp",
  "description": "Build and debug C/C++ in VS Code with a compact Windows x64 Clang, LLD and LLDB toolchain. 在 VS Code 中一键编译和调试 C/C++。",
  "version": "1.5.1",
  "publisher": "Nebulazeyv-RealSXB",
  "icon": "smartstart.png",
  "author": {
    "name": "RealSXB(Nebulazeyv)",
    "url": "https://github.com/realsxb"
  },
  "homepage": "https://buaahmjh.com/en/projects/nbcpp",
  "repository": {
    "type": "git",
    "url": "https://github.com/realsxb/nobrainercpp.git"
  },
  "bugs": {
    "url": "https://github.com/realsxb/nobrainercpp/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Education"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onDebugResolve:my-simple-lldb"
  ],
  "extensionDependencies": [

  ],
  "main": "./out/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "nobrainercpp",
        "required": ["file", "language", "compiler"],
        "properties": {
          "file": { "type": "string" },
          "language": { "enum": ["c", "cpp"] },
          "compiler": { "type": "string" }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "gcc",
        "owner": "cpp",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "debuggers": [
      {
        "type": "my-simple-lldb",
        "label": "NBCpp C/C++",
        "program": "./lldbv1.0/bin/lldb-dap.exe",
        "windows": {
          "program": "./lldbv1.0/bin/lldb-dap.exe"
        },
        "languages": [
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "nbcppActiveFile": {
                "type": "boolean",
                "description": "%debug.activeFile%",
                "default": false
              },
              "logFile": {
                "type": "string",
                "description": "%debug.logFile%",
                "default": "${workspaceFolder}/dap-log.txt"
              },
              "program": {
                "type": "string",
                "description": "%debug.program%",
                "default": "${fileDirname}/${fileBasenameNoExtension}.exe"
              },
              "args": {
                "type": "array",
                "description": "%debug.args%",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "%debug.cwd%",
                "default": "${workspaceFolder}"
              },
              "runInTerminal": {
                "type": "boolean",
                "description": "%debug.terminal%",
                "default": true
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "%debug.stopAtEntry%",
                "default": false
              },
              "env": {
                "type": "object",
                "description": "%debug.env%",
                "default": {}
              }
            }
          }
        }
      }
    ],
    "commands": [
      {
        "command": "easycpp.debugC",
        "title": "Debug C (GCC/Clang)"
      },
      {
        "command": "easycpp.debugCpp",
        "title": "Debug C++ (G++/Clang++)"
      },
      {
        "command": "extension.autoDebug",
        "title": "Smart Run C/C++",
        "category": "C/C++",
        "icon": {
          "light": "smartstart.svg",
          "dark": "smartstart.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "easycpp.debugC",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus"
      },
      {
        "command": "easycpp.debugCpp",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "extension.autoDebug"
        }
      ],
      "editor/title": [
        {
          "command": "extension.autoDebug",
          "when": "resourceLangId == cpp || resourceLangId == c",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
